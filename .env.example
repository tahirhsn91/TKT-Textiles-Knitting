# Copy this file to .env and adjust as needed.
# docker-compose.yml falls back to the defaults shown here if .env is absent,
# so this file is safe to keep as-is for local development.

POSTGRES_DB=heliumdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Comma-separated list of origins allowed to call the backend API directly
# (same-origin requests through the frontend's nginx/Vercel proxy don't need this).
ALLOWED_ORIGINS=http://localhost:3000
