# ═══════════════════════════════════════════════════════════════
# WARNING: This file contains PLACEHOLDER values only.
# Copy this file to .env and fill in your REAL credentials there.
# NEVER commit .env or .env.prod — they are git-ignored.
# ═══════════════════════════════════════════════════════════════
#
# docker-compose.yml falls back to the defaults shown here if .env
# is absent, so this file is safe to keep in version control.

POSTGRES_DB=heliumdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production

# Backend database connection. If unset, docker-compose falls back to the
# bundled local Postgres service. Set this to use an external DB (e.g. Neon):
# DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require

# Comma-separated list of origins allowed to call the backend API directly
# (same-origin requests through the frontend's nginx/Vercel proxy don't need this).
ALLOWED_ORIGINS=http://localhost:3000

# Auth (issue #135) — used to sign/verify the 24h bearer JWTs returned at login.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-64-hex-char-random-secret
